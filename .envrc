# Backfill rubygems autoloads that Bundler 4.x doesn't implicitly
# trigger. Without this, `bin/kitchen verify` fails with
# `uninitialized constant Gem::Package::TarWriter` (in inspec's
# archive/tar.rb) and `Gem::Package::TarHeader` (in docker-api's
# util.rb). The single require pulls in the whole rubygems/package
# family via the require_relative chain at rubygems/package.rb:734-742.
# CI sets the same env in .github/workflows/kitchen.yml.
export RUBYOPT="-rrubygems/package${RUBYOPT:+ $RUBYOPT}"
